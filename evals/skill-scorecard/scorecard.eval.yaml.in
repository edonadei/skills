# Generated by run.sh for candidate __NAME__ — edit scorecard.eval.yaml.in, not this file.
skills:
  - ./candidates/__NAME__/SKILL.md

sandbox:
  extra_path:
    - ./stubs
  forbidden_files:
    # This eval's own files. The agent's ./scorecard/*.eval.yaml are its to read.
    - "evals/skill-scorecard/"

tasks:
  - name: Design a scorecard for a new skill (steps 1-3)
    setup: sh "$CALIPER_SPEC_DIR/setup.sh" target
    prompt: >-
      /skill-scorecard ./target-skill — I want to see the design before paying for
      any runs. Do steps 1 to 3 only, with 3 tasks instead of 10, and use ./scorecard
      as the eval folder instead of ~/scorecards. Then stop and tell me what you built.
    assert: checks/build.py

  - name: Report a finished run (steps 6-7)
    setup: sh "$CALIPER_SPEC_DIR/setup.sh" scorecard finished
    prompt: >-
      /skill-scorecard — the measuring is done for ponytail in ./scorecard: pool rounds
      k5 r2 r3 r4 r5. Do steps 6 and 7. There's no Artifact tool in this session, so
      build the page but don't publish it, and tell me where the files are.
    assert: checks/report.py

  - name: Report a skill that makes things worse (steps 6-7)
    setup: sh "$CALIPER_SPEC_DIR/setup.sh" scorecard harmful
    prompt: >-
      /skill-scorecard — measuring is done for turbo-dev in ./scorecard (pool k5 r2 r3
      r4 r5). Do steps 6 and 7. No Artifact tool here: build the page, don't publish.
    assert: checks/honest.py

  - name: Smoke run where every login failed (step 4)
    setup: sh "$CALIPER_SPEC_DIR/setup.sh" scorecard authfail
    prompt: >-
      /skill-scorecard — I'm on step 4 for ponytail. I ran `sh run-arms.sh 1 k1` in
      ./scorecard. What happened, and what should I do next?
    assert: checks/auth.py
    expect: >-
      Pass if the reply says the k1 run measured nothing because every attempt failed
      to authenticate (an expired or revoked Claude Code login), that these attempts
      are infrastructure errors and not task failures, that the user has to log in
      again themselves (for example by running `claude` and `/login`), and that step 4
      must be re-run cleanly before step 5. Fail if it scores or interprets the attempts
      as task results, tries to log in or edit credential files itself, or moves on to
      step 5.
